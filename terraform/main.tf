data "aws_availability_zones" "available" { state = "available" }
module "vpc" { source = "terraform-aws-modules/vpc/aws"; version = "5.13.0"; name = var.project; cidr = var.vpc_cidr; azs = slice(data.aws_availability_zones.available.names, 0, 2); private_subnets = ["10.70.1.0/24", "10.70.2.0/24"]; public_subnets = ["10.70.101.0/24", "10.70.102.0/24"]; enable_nat_gateway = true; single_nat_gateway = var.environment != "prod"; enable_dns_hostnames = true }
resource "aws_ecr_repository" "api" { name = "${var.project}/release-api"; image_tag_mutability = "IMMUTABLE"; image_scanning_configuration { scan_on_push = true }; encryption_configuration { encryption_type = "AES256" } }
resource "aws_cloudwatch_log_group" "api" { name = "/nebula/${var.project}/release-api"; retention_in_days = 30 }
resource "aws_ecs_cluster" "canary" { name = "${var.project}-canary"; setting { name = "containerInsights"; value = "enabled" } }
resource "aws_security_group" "canary" { name = "${var.project}-canary"; description = "Egress-only canary service"; vpc_id = module.vpc.vpc_id; egress { from_port = 0; to_port = 0; protocol = "-1"; cidr_blocks = ["0.0.0.0/0"] } }
data "aws_iam_policy_document" "ecs_assume" { statement { actions = ["sts:AssumeRole"]; principals { type = "Service"; identifiers = ["ecs-tasks.amazonaws.com"] } } }
resource "aws_iam_role" "execution" { name = "${var.project}-ecs-execution"; assume_role_policy = data.aws_iam_policy_document.ecs_assume.json }
resource "aws_iam_role_policy_attachment" "execution" { role = aws_iam_role.execution.name; policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy" }
resource "aws_ecs_task_definition" "canary" { family = "${var.project}-canary"; requires_compatibilities = ["FARGATE"]; network_mode = "awsvpc"; cpu = 256; memory = 512; execution_role_arn = aws_iam_role.execution.arn; container_definitions = jsonencode([{ name = "release-api", image = var.container_image, essential = true, portMappings = [{ containerPort = 8080 }], environment = [{ name = "RELEASE_ID", value = "terraform-canary" }], logConfiguration = { logDriver = "awslogs", options = { awslogs-group = aws_cloudwatch_log_group.api.name, awslogs-region = var.aws_region, awslogs-stream-prefix = "ecs" } } }]) }
resource "aws_ecs_service" "canary" { name = "${var.project}-canary"; cluster = aws_ecs_cluster.canary.id; task_definition = aws_ecs_task_definition.canary.arn; desired_count = 2; launch_type = "FARGATE"; network_configuration { subnets = module.vpc.private_subnets; security_groups = [aws_security_group.canary.id]; assign_public_ip = false }; deployment_minimum_healthy_percent = 100; deployment_maximum_percent = 200 }
resource "aws_cloudwatch_metric_alarm" "task_count" { alarm_name = "${var.project}-canary-low-capacity"; namespace = "ECS/ContainerInsights"; metric_name = "RunningTaskCount"; dimensions = [{ name = "ClusterName", value = aws_ecs_cluster.canary.name }, { name = "ServiceName", value = aws_ecs_service.canary.name }]; statistic = "Minimum"; period = 60; evaluation_periods = 3; threshold = 1; comparison_operator = "LessThanThreshold"; treat_missing_data = "breaching" }
output "ecr_repository" { value = aws_ecr_repository.api.repository_url }
